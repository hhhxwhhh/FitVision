# Base URL used by the API client.
# Leave it as `/api` during development: Vite proxies /api and /media to the
# Django server (see vite.config.ts). For a production build you can point it
# at your deployed backend, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Backend origin used by the Vite dev-server proxy.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
