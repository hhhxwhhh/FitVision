# =============================================================================
# FitVision backend configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` — it is ignored by git.
# =============================================================================

# ---- Django ----------------------------------------------------------------
DEBUG=True
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database --------------------------------------------------------------
# Leave DB_NAME empty to use the bundled SQLite database (easiest for dev/CI).
# Fill it in to use PostgreSQL instead.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- Cache / task queue ----------------------------------------------------
# `locmem` (in-process, no extra service) or `redis`.
CACHE_BACKEND=locmem
REDIS_URL=redis://127.0.0.1:6379/0

# ---- LLM services ----------------------------------------------------------
# DeepSeek: text analysis / plan generation
DEEPSEEK_API_KEY=
# Vision-language model used by posture diagnosis (OpenAI-compatible API)
CN_VLM_API_KEY=
CN_VLM_MODEL=doubao-1.5-vision-pro-250328
CN_VLM_BASE_URL=https://openkey.cloud/v1

# ---- Misc ------------------------------------------------------------------
# Hugging Face mirror (useful when huggingface.co is slow/unreachable)
HF_ENDPOINT=https://hf-mirror.com
